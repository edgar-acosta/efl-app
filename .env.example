# Copia este archivo como .env y completa los valores del entorno DEV.
# El .env nunca se sube al repo (está en .gitignore).

# URL base del entorno DEV (obligatoria, sin valor por defecto:
# el flujo solo corre en alcance de pruebas, nunca en producción).
EFL_BASE_URL=https://dev.enlacefl.example/

# Cuenta de pruebas del entorno DEV.
EFL_USER=usuario.pruebas@example.com
EFL_PASS=cambiar-por-la-contrasena-de-pruebas

# Datos de "Ver como" en DEV. Los valores por defecto son los del
# cliente tutorial verificados en el POC; ajústalos a los datos de DEV.
EFL_CLIENT=TUTORIAL__PRUEBAS
EFL_ROLE=OWNER
EFL_TEST_USER=TUTORIAL__prueba hesa__pruebas
